{
  "name": "flowcap",
  "version": "0.47.28",
  "private": true,
  "description": "抖音直播间自动私信控制台 - Tauri + FastAPI 重构版",
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "backend:dev": "cd backend && uvicorn main:app --reload --port 8000",
    "build:sidecar": "python scripts/build_sidecar.py",
    "gen:api": "bash scripts/gen_api_client.sh",
    "lint": "npm run lint --workspace frontend"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "js-yaml": "^4.3.2",
    "brace-expansion": "^2.1.7"
  },
  "workspaces": [
    "frontend"
  ],
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
