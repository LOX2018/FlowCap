# 根目录大文件 / 外部下载产物（不入库，从 Release 重新下载即可）
*.zip
*.tar.gz
*.7z
*.exe

# 浏览器指纹内核运行时 profile（Chromium 缓存/登录态/本地存储，体积大且含敏感信息）
vb_profile_*/
vb_profile_dm/
vb_profile_default/
pw_profile_dm/
pw_profile_default/
chromium_profile*/

# 打包产物
dist/
build/
*.spec
__pycache__/
*.pyc
*.pyo

# 账号凭证 / 环境变量 / 日志
.env
.env.*
*.env.bak
.env.stray_bak
logs/
*.log

# 前端依赖与 vendor（若未来引入 node_modules）
node_modules/

# 编辑器 / 系统 / 临时
.vscode/
.idea/
*.swp
.DS_Store
.codebuddy/

# 内存快照 / 调试产物
*.pma
*.tmp
~$*

# MCP 浏览器测试快照
.playwright-mcp/

# ===== DYAutoDM_v2 运行时/构建缓存（不入库）=====
DYAutoDM_v2/auto_dm/
DYAutoDM_v2/data/
DYAutoDM_v2/vb_chromium/
DYAutoDM_v2/build_tauri.err
DYAutoDM_v2/*.log
frontend/tsconfig.tsbuildinfo
frontend/tsconfig.node.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts
_commit_msg.txt
# V1 (DY_Spider_base) 已彻底清理废弃，永不重新跟踪
DY_Spider_base/

# 2026-08-31 追加：运行数据库（含真实私信/昵称，绝不入库）
data/*.db
data/*.db-shm
data/*.db-wal

# 一次性知识库写入脚本（用完即弃）
工作记忆/_kb*.py

# OCR 审查的**中间分诊产物**（原始机器报告的子集/重切）。
# 权威源是 D:\SJ  agent 下的完整报告，这些只是处理过程中的切片，
# 体积可达 MB 级且会随处理进度不断重写 → 不入库，避免污染历史。
# 处置结论一律落在 工作记忆/*.md 文档里（人可读、可评审）。
工作记忆/ocr_remaining_items.json
工作记忆/ocr_high_still.json
工作记忆/ocr_high_gone.json

# ── 2026-09-20 补充（实测污染源，防复发）─────────────────────────
# 1) 未展开的环境变量被当路径：tauri dev 期间 Windows 字体缓存工具在
#    src-tauri/ 下创建了字面量目录 `%SystemDrive%/ProgramData/...`
**/%SystemDrive%/
**/%ProgramData%/
**/%SystemRoot%/
**/%TEMP%/
**/%APPDATA%/
# 2) 源码树运行期数据目录（铁律：源码目录不得产生 data/accounts）
DYAutoDM_v2/src-tauri/data/
DYAutoDM_v2/src-tauri/accounts/
DYAutoDM_v2/accounts/
# 3) 知识库/Docs 的 .bak.<时间戳> 备份（我自己脚本生成的，不入库）
*.bak.[0-9]*
*.bak2.[0-9]*
