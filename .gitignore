# 根目录大文件 / 外部下载产物（不入库，从 Release 重新下载即可）
*.zip
*.tar.gz
*.7z
*.exe

# 浏览器指纹内核运行时 profile（Chromium 缓存/登录态/本地存储，体积大且含敏感信息）
vb_profile_*/
vb_profile_dm/
vb_profile_default/
pw_profile_dm/
pw_profile_default/
chromium_profile*/

# 打包产物
dist/
build/
*.spec
__pycache__/
*.pyc
*.pyo

# 账号凭证 / 环境变量 / 日志
.env
.env.*
*.env.bak
.env.stray_bak
logs/
*.log

# 前端依赖与 vendor（若未来引入 node_modules）
node_modules/

# 编辑器 / 系统 / 临时
.vscode/
.idea/
*.swp
.DS_Store
.codebuddy/

# 内存快照 / 调试产物
*.pma
*.tmp
~$*

# MCP 浏览器测试快照
.playwright-mcp/
