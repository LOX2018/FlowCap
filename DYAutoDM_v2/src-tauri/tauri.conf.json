{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DYAutoDM",
  "version": "0.2.0",
  "identifier": "com.dyautodm.console",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --workspace frontend",
    "beforeBuildCommand": "npm run build --workspace frontend"
  },
  "app": {
    "windows": [
      {
        "title": "抖音直播间自动私信 · 控制台",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "backgroundColor": "#0f1320",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [
      "binaries/dyautodm-backend",
      "binaries/dyautodm-browser-daemon",
      "binaries/dyautodm-recv-daemon"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {}
}
