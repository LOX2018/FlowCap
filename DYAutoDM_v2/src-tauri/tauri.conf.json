{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DYAutoDM",
  "version": "0.44.50",
  "identifier": "com.dyautodm.console",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --workspace frontend",
    "beforeBuildCommand": "npm run build --workspace frontend"
  },
  "app": {
    "windows": [
      {
        "title": "\u6296\u97f3\u76f4\u64ad\u95f4\u81ea\u52a8\u79c1\u4fe1 \u00b7 \u63a7\u5236\u53f0",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 680,
        "backgroundColor": "#0f1320",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../vb_profile_default",
      "../vb_profile_dm",
      "../pw_profile_dm"
    ],
    "externalBin": [
      "binaries/dyautodm-backend",
      "binaries/dyautodm-browser-daemon",
      "binaries/dyautodm-recv-daemon"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {}
}
